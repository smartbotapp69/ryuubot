RYUBOT_ENV=development
RYUBOT_HTTP_ADDR=127.0.0.1:8080
RYUBOT_DATABASE_URL=postgresql://USER:PASSWORD@127.0.0.1:5432/ryubot
RYUBOT_SESSION_SECRET=replace-with-a-unique-random-secret-at-least-32-characters

# Login admin hanya berasal dari environment, bukan tabel database.
RYUBOT_ADMIN_USERNAME=admin
RYUBOT_ADMIN_PASSWORD=replace-with-a-strong-password

PASINO_API_BASE_URL=https://api.pasino.io
PASINO_SOCKET_URL=wss://socket.pasino.io/dice/
PASINO_API_KEY=
PASINO_CREDENTIAL_ENCRYPTION_KEY=
# Opsional — proxy SOCKS5/HTTP ber-IP bersih untuk egress Pasino bila IP VPS
# diblokir edge Pasino (HTTP 403). Contoh: socks5h://user:pass@host:1080
PASINO_PROXY_URL=
