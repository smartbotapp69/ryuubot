RYUBOT_ENV=production
RYUBOT_HTTP_ADDR=127.0.0.1:8080
RYUBOT_SHUTDOWN_TIMEOUT=15s
RYUBOT_TRUSTED_PROXIES=127.0.0.1/32
RYUBOT_RATE_PER_SECOND=10
RYUBOT_RATE_BURST=30
RYUBOT_MAX_BODY_BYTES=1048576
RYUBOT_SESSION_SECRET=
RYUBOT_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ryubot_go
RYUBOT_LEGACY_DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/ryuubot
PASINO_API_KEY=
PASINO_CREDENTIAL_ENCRYPTION_KEY=
RYUBOT_ADMIN_USERNAME=
RYUBOT_ADMIN_PASSWORD=
